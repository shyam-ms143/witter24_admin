# Where the dev server proxies /api (twitter24_node_be runs on PORT=3001 in .env.development)
API_PROXY_TARGET=http://localhost:3001

# Absolute API origin for production builds that are NOT served behind the same domain as the API,
# e.g. https://api.witter24.com (that origin must then be listed in the API's CORS_ORIGINS).
# Leave empty to call /api/admin on the same origin.
VITE_API_URL=
